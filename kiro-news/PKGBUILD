# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-news
_destname1="/etc"
_destname2="/usr"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=05
pkgdesc="In-system news notifier for Kiro — Arch news plus Kiro's own signed feed (by Erik Dubois)"
arch=('any')
url="https://github.com/kirodubes/kiro-news"
license=('GPL3')
depends=('bash' 'curl' 'jq' 'libnotify')
optdepends=('minisign: verify Kiro signed feed (required once Kiro signing is enabled)')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

package() {
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}${_licensedir}${pkgname}/LICENSE"

	install -dm755 "${pkgdir}${_destname1}"
	cp -a "${srcdir}/${pkgname}/${_destname1}/." "${pkgdir}${_destname1}/"

	install -dm755 "${pkgdir}${_destname2}"
	cp -a "${srcdir}/${pkgname}/${_destname2}/." "${pkgdir}${_destname2}/"
}
