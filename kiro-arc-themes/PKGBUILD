sha256sums=('SKIP')

# Install the four variant folders for one colour (exact match, so
# e.g. Azure never grabs Azure-dodger-blue).
_install_color() {
  local token="$1" v d themes="${srcdir}/${pkgbase}/usr/share/themes"
  install -dm755 "${pkgdir}/usr/share/themes"
  for v in "" "-Dark" "-Darker" "-Lighter"; do
    d="Arc-${token}${v}"
    [[ -d "${themes}/${d}" ]] && cp -r "${themes}/${d}" "${pkgdir}/usr/share/themes/"
  done
}

package_kiro-arc-aqua() {
  pkgdesc="Arc Aqua recoloured GTK theme"
  replaces=('arcolinux-arc-aqua-git')
  conflicts=('arcolinux-arc-aqua-git')
  _install_color "Aqua"
}

