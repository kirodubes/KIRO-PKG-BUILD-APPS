# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-starship
pkgver=26.06
pkgrel=06
pkgdesc="Starship prompt configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-starship"
license=('GPL3')
makedepends=('git')
depends=('starship')
provides=("${pkgname}")
install=${pkgname}.install
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}.git")
sha256sums=('SKIP')
package() {
    cp -a "${srcdir}/${pkgname}/etc" "${pkgdir}/"
    # /usr/share payload: the canonical default that fish-tweak-tool reads for its
    # "Kiro default" starship preset (/etc/skel is only the new-user template).
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/"
}
