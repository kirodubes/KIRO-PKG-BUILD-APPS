post_install() {
    echo -e "\n** Kiro starship config installed to /etc/skel/.config/starship.toml **"
    echo -e "** New users inherit it automatically. **"
    echo -e "** To use it on your current account, copy it to your home: **"
    echo -e "**   cp /etc/skel/.config/starship.toml ~/.config/starship.toml **"
    echo -e "** Backup / restore the default from: /usr/share/kiro/starship/starship.toml **\n"
}

post_upgrade() {
    post_install
}
