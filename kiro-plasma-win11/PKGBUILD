# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-win11
pkgver=26.09
pkgrel=01
pkgdesc="Windows 11 look Plasma global theme — Win11OS Light + Dark (desktoptheme, look-and-feel, aurorae, color schemes, Kvantum, SDDM, cursors); bundles renamed Win11 icons"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-win11.git"
license=('GPL3')
depends=('kvantum' 'sddm' 'kiro-kvantum')
makedepends=('git' 'gtk-update-icon-cache')
provides=("${pkgname}")
options=(!strip !emptydirs)
install=kiro-plasma-win11.install
_iconurl="https://github.com/yeyushengfan258/Win11-icon-theme.git"
source=(${pkgname}::"git+${url}"
        "win11-icon-theme::git+${_iconurl}")
sha256sums=('SKIP'
            'SKIP')

package() {
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/usr"

    # Bundle the Win11 icon theme, re-fetched fresh on every build, installed under the
    # name "kiro-win11" so it never conflicts with an AUR win11-icon-theme package. The
    # look-and-feel defaults reference kiro-win11 to match.
    install -dm755 "${pkgdir}/usr/share/icons"
    ( cd "${srcdir}/win11-icon-theme" && ./install.sh -n kiro-win11 -d "${pkgdir}/usr/share/icons" )
}
