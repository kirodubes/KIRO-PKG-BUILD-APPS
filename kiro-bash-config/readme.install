post_install() {
    cp /etc/skel/.bashrc-latest /etc/skel/.bashrc
    echo -e "\n** Kiro bash config installed to /etc/skel/.bashrc **"
    echo -e "** New users inherit it automatically. **"
    echo -e "** To use it on your current account, copy the stub to your home: **"
    echo -e "**   cp /etc/skel/.bashrc ~/.bashrc **\n"
}

post_upgrade() {
    post_install
}
