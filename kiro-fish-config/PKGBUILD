# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-fish-config
pkgver=26.09
pkgrel=01
pkgdesc="Fish shell configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-fish-config"
license=('GPL3')
conflicts=('cachyos-fish-config')
makedepends=('git')
depends=('fish')
optdepends=('eza: nicer ls listing'
           'bat: colourised man pager'
           'fastfetch: system summary greeting'
           'expac: big/rip package aliases'
           'hwinfo: hw hardware-summary alias')
provides=("${pkgname}")
install=${pkgname}.install
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}.git")
sha256sums=('SKIP')
package() {
    cp -a "${srcdir}/${pkgname}/etc" "${pkgdir}/"
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/"
}
