# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-river
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="river desktop edition for Kiro (river-classic + waybar, dwm-style dynamic tiling, pywal)"
arch=('any')
url="https://github.com/kirodubes/kiro-river"
license=('GPL3')
# river-classic is the dynamic-tiling river (ships river + riverctl + rivertile).
# NOT the new compositor-only 'river' (0.4+) — they file-conflict on /usr/bin/river.
# Layout generator is the built-in rivertile (zero build); wideriver (AUR, dwm/xmonad
# layouts) is the documented upgrade and would be the line's first nemesis_repo build.
depends=('river-classic' 'swaybg' 'variety' 'kiro-variety-config'
         'waybar' 'rofi'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'dconf')
optdepends=('wideriver: dwm/xmonad-style layout generator (richer than rivertile)'
            'fuzzel: lean wlroots-native launcher (alternative to rofi)'
            'betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu'
            'wlsunset: blue-light filter / night mode')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (river/, waybar/, mako/, hypr/, the wallpaper, …).
	# cp -a preserves modes — CRUCIAL: ~/.config/river/init must stay executable
	# or river silently falls back to defaults.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Pristine, read-only golden copy of the desktop config at a stable path so the
	# config can be reset back to Kiro river after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-river"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-river/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
