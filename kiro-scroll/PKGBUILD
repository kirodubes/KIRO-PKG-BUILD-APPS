# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-scroll
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="scroll desktop edition for Kiro (sway-scroll + waybar, scrollable-tiling Wayland, pywal theming)"
arch=('any')
url="https://github.com/kirodubes/kiro-scroll"
license=('GPL3')
# sway-scroll is the shipped compositor (dawsers/scroll — a fork of sway with a
# PaperWM-style scrolling column layout). AUR-only upstream; Kiro builds it into
# nemesis_repo, so this package depends on it there.
depends=('sway-scroll' 'swaybg' 'variety' 'kiro-variety-config'
         'waybar' 'rofi'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'xorg-xwayland' 'dconf')
optdepends=('kanshi: multi-monitor output-profile daemon'
            'swaylock-effects: wlroots-native locker (alternative to hyprlock)'
            'betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu'
            'wlsunset: blue-light filter / night mode')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (scroll/, waybar/config-scroll.jsonc, the wallpaper, …).
	# cp -a preserves modes and includes hidden entries.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Pristine, read-only golden copy of the desktop config at a stable path so the
	# config can be reset back to Kiro scroll after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-scroll"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-scroll/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
