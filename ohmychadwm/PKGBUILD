	'maim'
	'make'
	'rofi'
	'slock'
	'sxhkd'
	'thunar'
	'ttf-jetbrains-mono-nerd'
	'noto-fonts-cjk'
	'wget'
	'xclip'
	'xorg-server'
	'xorg-xsetroot'
)

optdepends=(
  'fastcompmgr-git: compositor for transparency and effects'
  'xdotool: the showcase scripts in /usr/share/ohmychadwm/showcase'
  'network-manager-applet: network tray icon (autostarted)'
  'flameshot: screenshot tray (autostarted)'
  'xfce4-clipman-plugin: clipboard manager (autostarted)'
  'xfce4-power-manager: battery and display power management (autostarted)'
  'xfce4-notifyd: desktop notifications (autostarted)'
  'polkit-gnome: graphical password prompts (autostarted)'
  'volctl: volume tray icon (autostarted)'
  'blueberry: Bluetooth tray (autostarted)'
  'pamac-aur: update tray and package manager (autostarted)'
  'numlockx: numlock on at login (autostarted)'
  'xdg-user-dirs: create Desktop, Downloads, Documents at login'
  'gvfs: trash and automount in Thunar'
  'udisks2: mount USB drives from Thunar'
  'thunar-volman: automount removable media in Thunar'
  'thunar-archive-plugin: archive right-click menu in Thunar'
  'file-roller: archive backend for thunar-archive-plugin'
  'gnome-keyring: password storage for browsers'
  'playerctl: media keys'
  'xorg-xkill: Super+Shift+Escape kill window'
  'xorg-xbacklight: brightness keys'
  'scrot: Print key screenshot'
  'xfce4-appfinder: Alt+F2 and Alt+F3'
  'python-pywal16: wal colour scheme keybinding'
  'alacritty-tweak-tool: keybinding'
  'fish-tweak-tool: keybinding'
  'fastfetch-tweak-tool: keybinding'
