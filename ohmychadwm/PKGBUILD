pkgname=ohmychadwm
_pkgname=ohmychadwm
_destname1="/etc/skel/.config/"
_destname2="/etc/skel/.bin/"
#_destname3="/usr/share/licenses/dwm/"
#_destname4="/usr/share/man/man1/"
_destname5="/usr/"
_licensedir="/usr/share/edu/licenses/"
pkgver=26.11
pkgrel=17
pkgdesc="Configuration files"
arch=('any')
url="https://github.com/kirodubes/ohmychadwm"
replaces=('ohmychadwm-git')
conflicts=("ohmychadwm-git")
license=('GPL3')
makedepends=(
	'imlib2'
	'make'
	'gcc'
)
depends=(
	'ohmychadwm-tweak-tool'
	'kiro-ohmychadwm-hook'
	'kiro-keybindings'
	'acpi'
	'alacritty'
	'btop'
	'dmenu'
	'kiro-rofi'
	'kiro-rofi-themes'
	'kiro-powermenu'
	'pamixer'
	'feh'
	'lxappearance'
	'gcc'
