# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-hyprland-noctalia
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=02
pkgdesc="Hyprland desktop edition for Kiro (Hyprland + noctalia-shell)"
arch=('any')
url="https://github.com/kirodubes/kiro-hyprland-noctalia"
license=('GPL3')
# No conflict with the sibling editions: each Kiro edition ships its own config
# folder (~/.config/kiro-hyprland-noctalia/ here), session entry and wrapper — no
# shared files — so all can be installed together and picked per-login.
depends=('hyprland' 'uwsm' 'hyprpicker' 'noctalia-shell' 'kiro-noctalia'
         'kiro-wayland-dotfiles'
         'kiro-keybindings' 'xdg-desktop-portal-hyprland'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'polkit' 'dconf' 'uwsm')
optdepends=('cliphist: clipboard history for noctalia'
            'hyprsunset: blue-light filter / night mode'
            'hyprlock: alternative screen locker (noctalia locks by default)'
            'wlogout: graphical logout / power menu')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship this edition's skel tree (kiro-hyprland-noctalia/ + wallpaper). The
	# shared ~/.config/noctalia/ config comes from kiro-noctalia (a dependency),
	# not from here — noctalia reads that fixed path, so one owner avoids the
	# file conflict between editions. cp -a preserves modes and hidden entries.
	# System-wide dconf appearance defaults come from kiro-wayland-dotfiles.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Own session entry: a wrapper launches Hyprland pointed at this edition's own
	# config folder (~/.config/kiro-hyprland-noctalia/) via --config and ships as
	# "Kiro Hyprland Noctalia" — so switching editions never inherits a sibling's
	# stale ~/.config/hypr/.
	install -Dm755 "${_src}/usr/bin/kiro-hyprland-noctalia-session" \
		"${pkgdir}/usr/bin/kiro-hyprland-noctalia-session"
	install -Dm755 "${_src}/usr/bin/kiro-hyprland-noctalia-hide-upstream-session" \
		"${pkgdir}/usr/bin/kiro-hyprland-noctalia-hide-upstream-session"
	install -Dm644 "${_src}/usr/share/wayland-sessions/kiro-hyprland-noctalia.desktop" \
		"${pkgdir}/usr/share/wayland-sessions/kiro-hyprland-noctalia.desktop"
	install -Dm644 "${_src}/usr/share/libalpm/hooks/kiro-hyprland-noctalia-hide-upstream-session.hook" \
		"${pkgdir}/usr/share/libalpm/hooks/kiro-hyprland-noctalia-hide-upstream-session.hook"

	# Pristine, read-only golden copy of the desktop config at a stable path so
	# the config can be reset back to Kiro Hyprland Noctalia after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-hyprland-noctalia"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-hyprland-noctalia/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
