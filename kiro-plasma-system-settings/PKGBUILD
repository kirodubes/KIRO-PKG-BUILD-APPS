# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-system-settings
_destname="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Default KDE Plasma System Settings configuration for Kiro (ships /etc/xdg cascade defaults)"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-system-settings"
license=('GPL3')
makedepends=('git')
depends=('kiro-plasma-nord')  # default theme/colors selected in /etc/xdg/kdeglobals point at Kiro-Nordic
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-system-settings.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	# Ship the Plasma defaults into /etc/xdg — KDE's XDG cascade default layer,
	# read beneath each user's ~/.config so they apply to every user, are never
	# overwritten, and uninstall cleanly. cp the dir CONTENTS to avoid nesting.
	install -dm755 ${pkgdir}${_destname}
	cp -a  ${srcdir}/${pkgname}${_destname}/. ${pkgdir}${_destname}/
}
