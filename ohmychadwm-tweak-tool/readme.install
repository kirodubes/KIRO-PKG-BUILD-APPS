post_install() {
    echo -e "\n** Ohmychadwm Tweak Tool installed"
    echo -e "** Launch it from your menu or run: ohmychadwm-tweak-tool (short: ott, or the old oma)"
    echo -e "** Look, bar & windows, wallpaper, displays, mouse & touchpad, startup apps, default apps and keys"
    echo -e "**\n"
}

post_upgrade() {
    post_install
}
