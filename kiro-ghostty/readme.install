post_install() {
    echo -e "\n** Kiro ghostty config installed to /etc/skel/.config/ghostty/ **"
    echo -e "** New users inherit it automatically. **"
    echo -e "** To use it on your current account, copy the stub to your home: **"
    echo -e "**   cp /etc/skel/.config/ghostty/config ~/.config/ghostty/config **\n"
}

post_upgrade() {
    post_install
}
