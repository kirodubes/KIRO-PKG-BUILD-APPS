# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-system-files
_destname1="/etc"
_destname2="/usr"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=09
pkgdesc="System-wide and user systemfiles (by Erik Dubois)"
arch=('any')
url="https://github.com/kirodubes/kiro-system-files"
license=('GPL3')
conflicts=('edu-system-files-git')
replaces=('edu-system-files-git')
depends=('bash' 'kiro-news' 'kiro-keyring' 'kiro-mirrorlist' 'jq')
optdepends=('wl-clipboard: --copy on Wayland')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

package() {
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}${_licensedir}${pkgname}/LICENSE"
	
	install -dm755 "${pkgdir}${_destname1}"
	cp -a "${srcdir}/${pkgname}/${_destname1}/." "${pkgdir}${_destname1}/"
	chmod 750 "${pkgdir}${_destname1}/sudoers.d"
	# Git only preserves the exec bit, so sudoers drop-ins arrive 0644 from
	# the checkout. sudo requires 0440 (root:root). Force-fix every file.
	chmod 0440 "${pkgdir}${_destname1}/sudoers.d"/*

	install -dm755 "${pkgdir}${_destname2}"
	cp -a "${srcdir}/${pkgname}/${_destname2}/." "${pkgdir}${_destname2}/"

}
