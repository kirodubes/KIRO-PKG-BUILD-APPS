# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-leftwm
_destname1="/etc/skel/.config/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Desktop configuration for Leftwm"
arch=('any')
url="https://github.com/kirodubes/kiro-leftwm"
license=('GPL3')
replaces=('edu-leftwm-git')
conflicts=('edu-leftwm-git')
makedepends=('git')
depends=()
optdepends=('ttf-sourcecodepro-nerd'
'ttf-iosevka-nerd' 
'ttf-material-design-iconic-font'
'ttf-meslo-nerd-font-powerlevel10k'
)
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-leftwm.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	install -dm755 ${pkgdir}${_destname1}
	cp -r  ${srcdir}/${pkgname}${_destname1}* ${pkgdir}${_destname1}
}
