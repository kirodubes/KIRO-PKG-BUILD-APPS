# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-bspwm
_destname="/etc/skel/.config/bspwm/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Desktop configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-bspwm"
license=('GPL3')
makedepends=()
conflicts=('edu-bspwm-git')
replaces=('edu-bspwm-git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-bspwm.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	install -dm755 ${pkgdir}${_destname}
	cp -r  ${srcdir}/${pkgname}${_destname}* ${pkgdir}${_destname}
}
