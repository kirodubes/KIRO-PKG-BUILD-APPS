# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-niri-dms
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=06
pkgdesc="niri desktop edition for Kiro (niri + DankMaterialShell, scrollable-tiling Wayland)"
arch=('any')
url="https://github.com/kirodubes/kiro-niri-dms"
license=('GPL3')
# No conflict with the sibling niri editions (kiro-niri, kiro-ohmyniri): each
# ships its own config folder (~/.config/kiro-niri-dms/ vs kiro-niri/ vs
# kiro-ohmyniri/), session entry, wrapper and hook — no shared files — so all
# can be installed and picked per-login.
depends=('niri>=26.04' 'dms-shell' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'matugen' 'cava' 'kimageformats'
         'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'wl-clipboard' 'grim' 'slurp'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'polkit' 'dconf'
         'xwayland-satellite')
optdepends=('power-profiles-daemon: power profile control via DMS (dms ipc call powerprofile)'
            'cliphist: persistent clipboard history'
            'cups-pk-helper: printing authentication agent'
            'xdg-desktop-portal-gnome: screencasting support (pulls GNOME deps incl. nautilus)')
makedepends=('git')
install="${pkgname}.install"
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (kiro-niri-dms/, the wallpaper, first-run script).
	# System-wide dconf appearance defaults come from kiro-wayland-dotfiles, not
	# this package; DMS themes its own bar + GTK apps from the wallpaper via
	# matugen at runtime.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Own session entry: a wrapper points niri at this edition's own config folder
	# (~/.config/kiro-niri-dms/ via NIRI_CONFIG) and ships as "Kiro Niri dms" — so
	# switching editions never inherits a sibling's stale ~/.config/niri/. The hook +
	# helper stamp NoDisplay=true on upstream's plain "Niri" entry (which would read
	# the now unused ~/.config/niri/) so only the Kiro entries are offered; the
	# .install applies it on first install, the hook re-applies after niri upgrades.
	install -Dm755 "${_src}/usr/bin/kiro-niri-dms-session" "${pkgdir}/usr/bin/kiro-niri-dms-session"
	install -Dm644 "${_src}/usr/share/wayland-sessions/kiro-niri-dms.desktop" \
		"${pkgdir}/usr/share/wayland-sessions/kiro-niri-dms.desktop"
	install -Dm755 "${_src}/usr/bin/kiro-niri-dms-hide-upstream-session" \
		"${pkgdir}/usr/bin/kiro-niri-dms-hide-upstream-session"
	install -Dm644 "${_src}/usr/share/libalpm/hooks/kiro-niri-dms-hide-upstream-session.hook" \
		"${pkgdir}/usr/share/libalpm/hooks/kiro-niri-dms-hide-upstream-session.hook"

	# Pristine, read-only golden copy of the desktop config at a stable path so
	# the config can be reset back to Kiro niri (DMS) after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-niri-dms"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-niri-dms/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
