# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-mango
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="mangowc desktop edition for Kiro (animated wlroots tiling, waybar, pywal theming)"
arch=('any')
url="https://github.com/kirodubes/kiro-mango"
license=('GPL3')
# mangowm is the compositor (cachyos — wired into Kiro's pacman.conf, no build).
depends=('mangowm' 'swaybg' 'variety' 'kiro-variety-config'
         'waybar' 'rofi'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'xorg-xwayland' 'dconf')
optdepends=('betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu')
makedepends=('git')
install="${pkgname}.install"
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the skel tree (mango/ config + autostart + scripts, waybar/config-mango).
	cp -a "${_src}/etc" "${pkgdir}/"

	# Session entrypoint: mango has no in-config autostart mechanism (unlike every
	# other KIROTUX compositor), so a wrapper script + our own .desktop entry pass
	# autostart.sh via `mango -s` explicitly. Ships as "Kiro Mango" alongside
	# upstream mangowm's plain "Mango" entry (own filename — no file conflict).
	install -Dm755 "${_src}/usr/bin/kiro-mango-session" "${pkgdir}/usr/bin/kiro-mango-session"
	install -Dm644 "${_src}/usr/share/wayland-sessions/kiro-mango.desktop" \
		"${pkgdir}/usr/share/wayland-sessions/kiro-mango.desktop"

	# Upstream mangowm ships its own plain "Mango" entry that runs `mango` with no
	# `-s autostart.sh` -> black screen, no waybar/wallpaper if picked by mistake.
	# Ship a hook + helper that stamp NoDisplay=true on it so only "Kiro Mango" is
	# offered; the .install applies it on first install (hook won't fire when
	# mangowm is already present), the hook re-applies after mangowm upgrades.
	install -Dm755 "${_src}/usr/bin/kiro-mango-hide-upstream-session" \
		"${pkgdir}/usr/bin/kiro-mango-hide-upstream-session"
	install -Dm644 "${_src}/usr/share/libalpm/hooks/kiro-mango-hide-upstream-session.hook" \
		"${pkgdir}/usr/share/libalpm/hooks/kiro-mango-hide-upstream-session.hook"

	# Pristine golden copy at a stable path.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-mango"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-mango/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
