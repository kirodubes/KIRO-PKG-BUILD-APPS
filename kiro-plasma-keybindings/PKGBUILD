# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-keybindings
_destname="/usr"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Kservice files for edu"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-keybindings"
license=('GPL3')
replaces=('edu-plasma-keybindings-git')
makedepends=('git')
conflicts=('edu-plasma-keybindings-git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-keybindings.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	# Copy CONTENTS into the dest (the license step already created ${pkgdir}/usr,
	# so a plain `cp -r src/usr dest/usr` would nest into dest/usr/usr).
	install -dm755 ${pkgdir}${_destname}
	cp -a  ${srcdir}/${pkgname}${_destname}/. ${pkgdir}${_destname}/

	# Skel seed: minimal kglobalshortcutsrc adding Super+Shift+Q to KWin's
	# Close-Window action (the one binding that can't be a /usr .desktop launcher).
	if [ -d "${srcdir}/${pkgname}/etc" ]; then
		install -dm755 ${pkgdir}/etc
		cp -a  ${srcdir}/${pkgname}/etc/. ${pkgdir}/etc/
	fi
}
