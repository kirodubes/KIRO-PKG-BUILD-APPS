# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-qtile
_destname1="/etc/skel/.config/qtile/"
_destname2="/usr/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=02
pkgdesc="Desktop configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-qtile"
license=('GPL3')
replaces=('edu-qtile-git')
makedepends=('git')
depends=(
	'qtile'
	'alacritty'
	'archlinux-logout-gtk4'
	'feh'
	'flameshot'
	'kiro-keybindings'
	'kiro-rofi'
	'kiro-rofi-themes'
	'numlockx'
	'pamixer'
	'playerctl'
	'rofi'
	'scrot'
	'thunar'
	'variety'
	'xdg-user-dirs'
	'xfce4-appfinder'
	'xfce4-screenshooter'
	'xorg-setxkbmap'
	'xorg-xbacklight'
	'xorg-xkill'
	'xorg-xsetroot'
)
optdepends=(
	'fastcompmgr-git: compositor for transparency and effects'
)
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-qtile.git")
sha256sums=('SKIP')
install='readme.install'
conflicts=('cachyos-qtile-settings' 'edu-qtile-git')
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	install -dm755 ${pkgdir}${_destname1}
	cp -r  ${srcdir}/${pkgname}${_destname1}* ${pkgdir}${_destname1}

	install -dm755 ${pkgdir}${_destname2}
	cp -r  ${srcdir}/${pkgname}${_destname2}* ${pkgdir}${_destname2}
}
