# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-window-management
_destname="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Default KWin window-management config for Kiro (ships /etc/xdg/kwinrulesrc)"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-window-management"
license=('GPL3')
makedepends=('git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-window-management.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	# Ship kwinrulesrc into /etc/xdg — KDE's XDG cascade default layer. cp the dir
	# CONTENTS to avoid nesting.
	install -dm755 ${pkgdir}${_destname}
	cp -a  ${srcdir}/${pkgname}${_destname}/. ${pkgdir}${_destname}/
}
