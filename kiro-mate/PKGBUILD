# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-mate
_destname1="/usr"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="mate defaults for Kiro — sets the Kiro wallpaper as the schema default (by Erik Dubois)"
arch=('any')
url="https://github.com/kirodubes/kiro-mate"
license=('GPL3')
# The override targets the org.mate.* schema; mate must be present or
# glib-compile-schemas fails the whole compile during the post-transaction hook.
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

package() {
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}${_licensedir}${pkgname}/LICENSE"

	install -dm755 "${pkgdir}${_destname1}"
	cp -a "${srcdir}/${pkgname}/${_destname1}/." "${pkgdir}${_destname1}/"
}
