# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-ohmyniri
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="niri desktop edition for Kiro with the kiro-hyprland look (niri + waybar/mako, static Tokyo Night)"
arch=('any')
url="https://github.com/kirodubes/kiro-ohmyniri"
license=('GPL3')
# No conflict with kiro-niri: each edition ships its own config folder
# (~/.config/kiro-ohmyniri/ vs kiro-niri/), session entry, wrapper and hook —
# no shared files — so both can be installed and picked per-login.
depends=('niri' 'waybar' 'swaybg' 'rofi' 'gtklock' 'swayidle'
         'kiro-wayland-dotfiles'
         'variety' 'kiro-variety-config'
         'kiro-keybindings'
         'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'wl-clipboard' 'grim' 'slurp'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl' 'dconf'
         'xwayland-satellite')
optdepends=('cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu'
            'wlsunset: blue-light filter / night mode')
makedepends=('git')
install="${pkgname}.install"
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (kiro-ohmyniri/, waybar/config-ohmyniri.jsonc, gtklock/,
	# the wallpaper, …) and the system-wide dconf appearance defaults. mako/config and
	# waybar/colors.css+style.css come from kiro-wayland-dotfiles, not from here.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Own session entry: a wrapper points niri at this edition's own config folder
	# (~/.config/kiro-ohmyniri/ via NIRI_CONFIG) and ships as "Kiro OhMyNiri" — so
	# switching editions never inherits the sibling's stale ~/.config/niri/. The hook +
	# helper stamp NoDisplay=true on upstream's plain "Niri" entry (which would read the
	# now unused ~/.config/niri/) so only "Kiro OhMyNiri" is offered; the .install
	# applies it on first install, the hook re-applies after niri upgrades.
	install -Dm755 "${_src}/usr/bin/kiro-ohmyniri-session" "${pkgdir}/usr/bin/kiro-ohmyniri-session"
	install -Dm644 "${_src}/usr/share/wayland-sessions/kiro-ohmyniri.desktop" \
		"${pkgdir}/usr/share/wayland-sessions/kiro-ohmyniri.desktop"
	install -Dm755 "${_src}/usr/bin/kiro-ohmyniri-hide-upstream-session" \
		"${pkgdir}/usr/bin/kiro-ohmyniri-hide-upstream-session"
	install -Dm644 "${_src}/usr/share/libalpm/hooks/kiro-ohmyniri-hide-upstream-session.hook" \
		"${pkgdir}/usr/share/libalpm/hooks/kiro-ohmyniri-hide-upstream-session.hook"

	# Pristine, read-only golden copy of the desktop config at a stable path so
	# the config can be reset back to Kiro ohmyniri after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-ohmyniri"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-ohmyniri/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
