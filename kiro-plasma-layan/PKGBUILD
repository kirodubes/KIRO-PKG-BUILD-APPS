pkgname=kiro-plasma-layan
pkgver=26.09
pkgrel=01
pkgdesc="Layan Plasma global theme — Layan dark (desktoptheme, look-and-feel, aurorae, color scheme, Kvantum, SDDM, Layan cursors); Tela icons"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-layan.git"
license=('GPL3')
depends=('tela-icon-theme' 'kvantum' 'sddm' 'kiro-kvantum')
makedepends=('git')
provides=("${pkgname}")
options=(!strip !emptydirs)
install=kiro-plasma-layan.install
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')

package() {
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/usr"
}
