# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-gdrive
_pkgname=kiro-gdrive
_destname1="/usr"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.10
pkgrel=09
pkgdesc="KiroTux Drive — mount shared Google Drive folders read-only (GTK4 + CLI, rclone)"
arch=('any')
url="https://github.com/kirodubes/${_pkgname}"
license=('GPL3')
depends=('rclone' 'fuse3' 'python' 'python-gobject' 'gtk4')
optdepends=('kiro-news: daily notification when a shared folder gets new files')
makedepends=('git')
provides=("${pkgname}")
options=(!strip !emptydirs)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 "${pkgdir}${_licensedir}${_pkgname}"
	install -m644 "${srcdir}/${_pkgname}/LICENSE" "${pkgdir}${_licensedir}${_pkgname}/LICENSE"
	cp -r "${srcdir}/${_pkgname}/${_destname1}" "${pkgdir}"
	cp -r "${srcdir}/${_pkgname}/etc" "${pkgdir}"
}
