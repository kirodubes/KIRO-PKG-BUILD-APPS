# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-dot-files
_destname1="/usr"
_destname2="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="System-wide and user dotfiles (by Erik Dubois)"
arch=('any')
url="https://github.com/kirodubes/kiro-dot-files"
license=('GPL3')
conflicts=('edu-dot-files-git' 'cachyos-hyprland-settings' 
'cachyos-niri-settings' 'cachyos-niri-noctalia' 'cachyos-alacritty-config'
'cachyos-i3wm-settings' 'cachyos-wayfire-settings')
replaces=('edu-dot-files-git')
depends=('bash')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

package() {
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}${_licensedir}${pkgname}/LICENSE"
	
	install -dm755 "${pkgdir}${_destname1}"
	cp -r "${srcdir}/${pkgname}/${_destname1}/." "${pkgdir}${_destname1}/"
	
	install -dm755 "${pkgdir}${_destname2}"
	cp -r "${srcdir}/${pkgname}${_destname2}/." "${pkgdir}${_destname2}/"

}
