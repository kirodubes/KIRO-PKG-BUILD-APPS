# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-labwc
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="labwc desktop edition for Kiro (Openbox-style stacking, waybar, pywal theming)"
arch=('any')
url="https://github.com/kirodubes/kiro-labwc"
license=('GPL3')
depends=('labwc' 'swaybg' 'variety' 'kiro-variety-config'
         'waybar' 'rofi'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'xorg-xwayland' 'dconf')
optdepends=('kanshi: multi-monitor output-profile daemon'
            'betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'awww: animated wallpaper (alternative to swaybg)'
            'labwc-gtktheme: derive a labwc titlebar theme from the GTK theme'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (labwc/, waybar/, mako/, hypr/, the wallpaper, …).
	cp -a "${_src}/etc" "${pkgdir}/"

	# Pristine, read-only golden copy of the desktop config at a stable path so the
	# config can be reset back to Kiro labwc after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-labwc"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-labwc/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
