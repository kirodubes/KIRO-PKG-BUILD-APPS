pkgname=kiro-papirus-dark-tela-grey
pkgver=26.09
pkgrel=01
_destname1="/usr/share/icons/"
pkgdesc="Papirus dark icons with Tela folders"
arch=('any')
url="https://github.com/kirodubes/kiro-papirus-dark-tela-grey.git"
license=('GPL3')
depends=('papirus-icon-theme')
makedepends=('git')
replaces=('edu-papirus-dark-tela-grey-git')
provides=("${pkgname}")
conflicts=('edu-papirus-dark-tela-grey-git')
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')
package() {
	install -dm 755 ${pkgdir}${_destname1}
    cp -r ${srcdir}/${pkgname}${_destname1}/* ${pkgdir}${_destname1}
}
