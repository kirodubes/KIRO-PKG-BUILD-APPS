# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-konsole
_destname="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Default Konsole configuration for Kiro (profile, colour scheme, konsolerc via /etc/skel)"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-konsole"
license=('GPL3')
makedepends=('git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-konsole.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	# Ship the Konsole profile/colourscheme/konsolerc via /etc/skel — seeded into a
	# new user's home at account creation. cp the dir CONTENTS to avoid nesting.
	install -dm755 ${pkgdir}${_destname}
	cp -a  ${srcdir}/${pkgname}${_destname}/. ${pkgdir}${_destname}/
}
