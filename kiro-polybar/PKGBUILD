# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-polybar
_destname1="/etc/skel/.config/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=02
pkgdesc="Polybar configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-polybar"
license=('GPL3')
replaces=('edu-polybar-git')
makedepends=()
conflicts=('edu-polybar-git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-polybar.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	install -dm755 ${pkgdir}${_destname1}
	cp -r  ${srcdir}/${pkgname}${_destname1}* ${pkgdir}${_destname1}
}
