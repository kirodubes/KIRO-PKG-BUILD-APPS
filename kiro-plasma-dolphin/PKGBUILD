# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-dolphin
_destname="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Default Dolphin configuration for Kiro (ships /etc/xdg/dolphinrc cascade default)"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-dolphin"
license=('GPL3')
makedepends=('git')
depends=()
provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-plasma-dolphin.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	install -dm755 ${pkgdir}${_licensedir}${pkgname}
	install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}

	# Ship dolphinrc into /etc/xdg — KDE's XDG cascade default layer, read beneath
	# each user's ~/.config so it applies to all users, is never overwritten, and
	# uninstalls cleanly. cp the dir CONTENTS to avoid nesting.
	install -dm755 ${pkgdir}${_destname}
	cp -a  ${srcdir}/${pkgname}${_destname}/. ${pkgdir}${_destname}/
}
