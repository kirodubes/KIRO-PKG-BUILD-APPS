# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-kvantum
_destname1="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Kvantum config"
arch=('any')
url="https://github.com/kirodubes/kiro-kvantum"
license=('GPL3')
depends=('bash')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

package() {
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}${_licensedir}${pkgname}/LICENSE"
	
	install -dm755 "${pkgdir}${_destname1}"
	cp -r "${srcdir}/${pkgname}/${_destname1}/." "${pkgdir}${_destname1}/"
}
