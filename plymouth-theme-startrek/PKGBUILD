# Maintainer: Erik Dubois <erik.dubois@gmail.com>

pkgname=plymouth-theme-startrek
pkgver=26.09
pkgrel=01
pkgdesc="Star Trek Starfleet boot splash theme for Plymouth"
arch=('any')
url="https://github.com/erikdubois/plymouth-theme-startrek"
license=('MIT')
depends=('plymouth')
install="${pkgname}.install"
source=("git+${url}.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/plymouth-theme-startrek"
    install -d "${pkgdir}/usr/share/plymouth/themes/startrek"
    install -m644 usr/share/plymouth/themes/startrek/*.png \
        "${pkgdir}/usr/share/plymouth/themes/startrek/"
    install -m644 usr/share/plymouth/themes/startrek/startrek.plymouth \
        "${pkgdir}/usr/share/plymouth/themes/startrek/"
    install -m644 usr/share/plymouth/themes/startrek/startrek.script \
        "${pkgdir}/usr/share/plymouth/themes/startrek/"
}
