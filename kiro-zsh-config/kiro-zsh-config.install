post_install() {
    echo -e "\n** Kiro zsh config installed to /etc/skel/.zshrc **"
    echo -e "** New users inherit it automatically. **"
    echo -e "** To use it on your current account, copy the stub to your home: **"
    echo -e "**   cp /etc/skel/.zshrc ~/.zshrc **\n"
}

post_upgrade() {
    post_install
}
