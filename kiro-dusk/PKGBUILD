# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-dusk
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="The dusk (dwm fork) edition of Kiro — a runtime-configured X11 tiling desktop"
arch=('x86_64')
url="https://github.com/kirodubes/kiro-dusk"
license=('MIT' 'GPL3')
makedepends=(
	'make'
	'gcc'
	'pkgconf'
)
depends=(
	# dusk's linked libraries (compiled binary)
	'libx11'
	'libxft'
	'libxinerama'
	'libxrender'
	'libxcb'
	'fontconfig'
	'libconfig'
	'yajl'
	'dbus'
	# X session
	'xorg-server'
	'xorg-xsetroot'
	# Kiro desktop stack
	'alacritty'
	'rofi'
	'kiro-rofi'
	'kiro-rofi-themes'
	'kiro-keybindings'
	'archlinux-logout-gtk4'
	'feh'
	'flameshot'
	'maim'
	'xclip'
	'polkit-gnome'
	'network-manager-applet'
	'xfce4-notifyd'
	'pavucontrol'
	'brightnessctl'
	'numlockx'
	'betterlockscreen'
	'ttf-jetbrains-mono-nerd'
)
optdepends=(
	'fastcompmgr-git: lightweight compositor (run.sh default)'
	'picom: alternative compositor'
	'volctl: volume tray applet'
	'blueberry: bluetooth tray applet'
	'xfce4-clipman-plugin: clipboard manager'
	'xfce4-power-manager: battery / display power management'
	'pamac: package manager tray'
	'slock: alternative screen locker'
)
provides=("${pkgname}")
options=(!strip !emptydirs)
install='readme.install'
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

build() {
	cd "${srcdir}/${pkgname}/dusk-src"
	# The Makefile regenerates config.h from config.def.h, then compiles dusk + duskc.
	make
}

package() {
	# Compiled binaries — installed manually to avoid the upstream Makefile's
	# hardcoded, non-DESTDIR write to /usr/share/xsessions; Kiro ships its own
	# xsession (exec-dusk) via the usr/ tree below.
	cd "${srcdir}/${pkgname}/dusk-src"
	install -Dm755 dusk  "${pkgdir}/usr/bin/dusk"
	install -Dm755 duskc "${pkgdir}/usr/bin/duskc"
	install -Dm644 dusk.1 "${pkgdir}/usr/share/man/man1/dusk.1"

	# Skel config + session entry (exec-dusk) + xsession desktop file.
	cd "${srcdir}/${pkgname}"
	install -dm755 "${pkgdir}/etc" "${pkgdir}/usr"
	cp -a etc/. "${pkgdir}/etc/"
	cp -a usr/. "${pkgdir}/usr/"

	# Pristine golden copy of the shipped config (for reset/restore tooling).
	install -dm755 "${pkgdir}/usr/share/kiro/${pkgname}"
	cp -a etc "${pkgdir}/usr/share/kiro/${pkgname}/"

	# Licenses — repo scaffold (GPL3) + dusk's own upstream MIT license.
	install -dm755 "${pkgdir}${_licensedir}${pkgname}"
	install -m644 LICENSE "${pkgdir}${_licensedir}${pkgname}/LICENSE"
	install -m644 dusk-src/LICENSE "${pkgdir}${_licensedir}${pkgname}/LICENSE.dusk"
}
