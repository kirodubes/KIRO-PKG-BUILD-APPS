# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-vimix-dark-tela
pkgver=26.09
pkgrel=01
_destname1="/usr/share/icons/"
pkgdesc="Vimix dark icons with Tela folders"
arch=('any')
url="https://github.com/kirodubes/kiro-vimix-dark-tela.git"
license=('GPL3')
depends=('vimix-icon-theme-git')
makedepends=('git')
replaces=('edu-vimix-dark-tela-git')
provides=("${pkgname}")
conflicts=('edu-vimix-dark-tela-git')
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')
package() {
	install -dm 755 ${pkgdir}${_destname1}
    cp -r ${srcdir}/${pkgname}${_destname1}/* ${pkgdir}${_destname1}
}
