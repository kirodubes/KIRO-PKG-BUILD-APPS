# Re-hide upstream Xfce's wayland session after any xfce4 install/upgrade
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/wayland-sessions/xfce-wayland.desktop

[Action]
Description = Hiding upstream Xfce wayland session till it is released
When = PostTransaction
Exec = /usr/bin/kiro-xfce-hide-upstream-session
