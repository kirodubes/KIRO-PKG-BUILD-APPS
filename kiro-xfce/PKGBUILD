# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-xfce
_destname1="/etc/skel/.config/Thunar/"
_destname2="/etc/skel/.config/xfce4/"
_destname3="/etc/skel/.config/autostart/"
_destname4="/usr/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Desktop configuration for edu"
arch=('any')
url="https://github.com/kirodubes/kiro-xfce"
license=('GPL3')
replaces=('edu-xfce-git')
makedepends=('git')
depends=()
conflicts=("arconet-xfce-nemesis" 'edu-xfce-git')
#provides=("${pkgname}")
options=(!strip !emptydirs)
source=(${pkgname}::"git+https://github.com/kirodubes/kiro-xfce.git")
sha256sums=('SKIP')
install='readme.install'
package() {
	mkdir -p "${pkgdir}${_licensedir}${pkgname}"
	mv "${srcdir}/${pkgname}/"LICENSE "${pkgdir}${_licensedir}${pkgname}/LICENSE"
	mkdir -p "${pkgdir}${_destname1}"
	cp -r "${srcdir}/${pkgname}/${_destname1}/"* "${pkgdir}${_destname1}"
	mkdir -p "${pkgdir}${_destname2}"
	cp -r "${srcdir}/${pkgname}/${_destname2}/"* "${pkgdir}${_destname2}"
	mkdir -p "${pkgdir}${_destname3}"
	cp -r "${srcdir}/${pkgname}/${_destname3}/"* "${pkgdir}${_destname3}"
	mkdir -p "${pkgdir}${_destname4}"
	cp -r "${srcdir}/${pkgname}/${_destname4}/"* "${pkgdir}${_destname4}"
}
