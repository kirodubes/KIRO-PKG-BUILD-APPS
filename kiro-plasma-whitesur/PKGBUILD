# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-plasma-whitesur
pkgver=26.09
pkgrel=01
pkgdesc="WhiteSur (macOS-style) Plasma global theme — WhiteSur + Alt (desktoptheme, look-and-feel, aurorae, color schemes, Kvantum, SDDM, WhiteSur cursors); bundles renamed WhiteSur icons"
arch=('any')
url="https://github.com/kirodubes/kiro-plasma-whitesur.git"
license=('GPL3')
depends=('kvantum' 'sddm' 'kiro-kvantum')
makedepends=('git' 'gtk-update-icon-cache')
provides=("${pkgname}")
options=(!strip !emptydirs)
install=kiro-plasma-whitesur.install
_iconurl="https://github.com/vinceliuice/WhiteSur-icon-theme.git"
source=(${pkgname}::"git+${url}"
        "whitesur-icon-theme::git+${_iconurl}")
sha256sums=('SKIP'
            'SKIP')

package() {
    cp -a "${srcdir}/${pkgname}/usr" "${pkgdir}/usr"

    # Bundle the WhiteSur icon theme, re-fetched fresh on every build, installed
    # under the name "kiro-whitesur" so it never conflicts with the AUR
    # whitesur-icon-theme package (which owns /usr/share/icons/WhiteSur). The
    # look-and-feel defaults reference kiro-whitesur{,-light,-dark} to match.
    install -dm755 "${pkgdir}/usr/share/icons"
    ( cd "${srcdir}/whitesur-icon-theme" && ./install.sh -n kiro-whitesur -d "${pkgdir}/usr/share/icons" )
}
