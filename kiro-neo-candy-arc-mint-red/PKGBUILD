pkgname=kiro-neo-candy-arc-mint-red
pkgver=26.09
pkgrel=01
_destname1="/usr/share/icons/"
pkgdesc="Beautyline icons completed for ArcoLinux + Candy icons + Mint icons"
arch=('any')
url="https://github.com/kirodubes/kiro-neo-candy-arc-mint-red.git"
license=('GPL3')
depends=('neo-candy-icons-git')
replaces=('edu-neo-candy-arc-mint-red-git')
makedepends=('git')
provides=("${pkgname}")
conflicts=('edu-neo-candy-arc-mint-red-git')
options=(!strip !emptydirs)
source=(${pkgname}::"git+${url}")
sha256sums=('SKIP')
package() {
	install -dm 755 ${pkgdir}${_destname1}
    cp -r ${srcdir}/${pkgname}${_destname1}/* ${pkgdir}${_destname1}
}
