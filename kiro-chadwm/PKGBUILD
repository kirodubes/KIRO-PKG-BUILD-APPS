# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-chadwm
_pkgname=chadwm
_destname1="/etc/skel/.config/"
_destname2="/etc/skel/.bin/"
_destname5="/usr/"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Desktop configuration for Kiro"
arch=('any')
url="https://github.com/kirodubes/kiro-chadwm"
license=('GPL3')
makedepends=(
	'imlib2'
	'make'
	'gcc'
)
depends=(
	'acpi'
	'alacritty'
	'btop'
	'dmenu'
	'kiro-rofi'
	'kiro-rofi-themes'
	'feh'
	'gcc'
	'git'
	'imlib2'
	'maim'
	'make'
	'rofi'
	'slock'
	'sxhkd'
	'ttf-jetbrains-mono-nerd'
	'wget'
	'xclip'
	'xorg-server'
	'xorg-xsetroot'
)

optdepends=(
  'fastcompmgr-git: compositor for transparency and effects'
)
provides=("${pkgname}")
conflicts=('edu-chadwm-git')
replaces=('edu-chadwm-git')
options=(!strip !emptydirs)
source=(${_pkgname}::"git+https://github.com/kirodubes/kiro-chadwm.git")
sha256sums=('SKIP')
install='readme.install'

build() {
  cd "$srcdir/$_pkgname/etc/skel/.config/chadwm/chadwm"
  make
}

package() {

  cd "$srcdir/$_pkgname/etc/skel/.config/chadwm/chadwm"
  make PREFIX=/usr DESTDIR="$pkgdir" install

	install -dm755 ${pkgdir}${_licensedir}${_pkgname}
	install -m644  ${srcdir}/${_pkgname}/LICENSE ${pkgdir}${_licensedir}${_pkgname}

	install -dm755 ${pkgdir}${_destname1}
	cp -r  ${srcdir}/${_pkgname}${_destname1}* ${pkgdir}${_destname1}

	install -dm755 ${pkgdir}${_destname2}
	cp -r  ${srcdir}/${_pkgname}${_destname2}* ${pkgdir}${_destname2}

	install -dm755 ${pkgdir}${_destname5}
	cp -r  ${srcdir}/${_pkgname}${_destname5}* ${pkgdir}${_destname5}
}
