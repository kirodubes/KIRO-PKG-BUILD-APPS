# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-sddm-simplicity
_destname1="/usr"
_destname2="/etc"
_licensedir="/usr/share/kiro/licenses/"
pkgver=26.09
pkgrel=01
pkgdesc="Simplicity theme from isseigx on gitlab"
arch=('any')
url="https://github.com/kirodubes/kiro-sddm-simplicity"
license=('GPL3')
conflicts=('edu-sddm-simplicity-git')
depends=('qt5-quickcontrols2' 'qt5-quickcontrols' 'qt5-virtualkeyboard')
makedepends=('git')
install=readme.install
makedepends=('git')
options=(!strip !emptydirs)
replaces=('edu-sddm-simplicity-git')
source=(${pkgname}::git+$url)
sha256sums=('SKIP')
package() {
  install -dm755 ${pkgdir}${_licensedir}${pkgname}
  install -m644  ${srcdir}/${pkgname}/LICENSE ${pkgdir}${_licensedir}${pkgname}
  cp -r ${srcdir}/${pkgname}/${_destname1} ${pkgdir}
  cp -r ${srcdir}/${pkgname}/${_destname2} ${pkgdir}
}
