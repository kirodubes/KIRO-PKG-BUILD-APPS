# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-wayfire
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=01
pkgdesc="wayfire desktop edition for Kiro (wayfire + waybar, 3D effects, fuzzel + nwg-drawer launchers, pywal theming)"
arch=('any')
url="https://github.com/kirodubes/kiro-wayfire"
license=('GPL3')
depends=('wayfire' 'wf-config' 'variety' 'kiro-variety-config'
         'waybar' 'swaybg' 'rofi' 'fuzzel' 'nwg-drawer'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'xorg-xwayland' 'dconf')
optdepends=('wcm: graphical wayfire config editor'
            'wayfire-plugins-extra: additional community plugins (chaotic-aur/cachyos)'
            'betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu'
            'wlsunset: blue-light filter / night mode')
makedepends=('git')
options=(!strip !emptydirs)
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (wayfire.ini, waybar/, mako/, hypr/, the wallpaper, …).
	# cp -a preserves modes and includes hidden entries.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Pristine, read-only golden copy of the desktop config at a stable path so the
	# config can be reset back to Kiro wayfire after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-wayfire"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-wayfire/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
