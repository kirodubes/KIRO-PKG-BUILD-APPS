# Maintainer: Erik Dubois <erik.dubois@gmail.com>
pkgname=kiro-wayfire
_licensedir="/usr/share/kiro/licenses"
pkgver=26.10
pkgrel=08
pkgdesc="wayfire desktop edition for Kiro (wayfire + waybar, 3D effects, fuzzel + rofi launchers, pywal theming)"
arch=('any')
url="https://github.com/kirodubes/kiro-wayfire"
license=('GPL3')
depends=('wayfire' 'wf-config' 'variety' 'kiro-variety-config'
         'waybar' 'swaybg' 'rofi' 'kiro-rofi' 'kiro-rofi-themes' 'kiro-powermenu' 'fuzzel'
         'python-pywal'
         'hyprpicker' 'kiro-wayland-dotfiles'
         'kiro-keybindings'
         'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk'
         'xdg-user-dirs' 'grim' 'slurp' 'wl-clipboard' 'wlr-randr'
         'polkit-gnome' 'network-manager-applet'
         'pavucontrol' 'playerctl' 'wireplumber' 'brightnessctl'
         'xorg-xwayland' 'dconf' 'wlsunset')
# wayfire-plugins-extra is left out until chaotic/cachyos rebuild it for wayfire 0.11 (0.10 builds don't load).
optdepends=('wcm: graphical wayfire config editor'
            'betterlockscreen: blurred lock-screen image cache (Ctrl+Alt+R)'
            'cliphist: clipboard history manager'
            'wlogout: graphical logout / power menu')
makedepends=('git')
options=(!strip !emptydirs)
install="${pkgname}.install"
source=("${pkgname}::git+${url}")
sha256sums=('SKIP')

package() {
	local _src="${srcdir}/${pkgname}"

	# Ship the whole skel tree (wayfire.ini, waybar/, mako/, hypr/, the wallpaper, …).
	# cp -a preserves modes and includes hidden entries.
	cp -a "${_src}/etc" "${pkgdir}/"

	# Own session entry: kiro-wayfire-session exports the Qt variables (wayfire.ini can't), then starts
	# wayfire. The hook + helper stamp NoDisplay=true on upstream's plain "Wayfire" entry so only
	# "Kiro Wayfire" is offered; the .install applies it on install and moves SDDM's remembered session.
	install -Dm755 "${_src}/usr/bin/kiro-wayfire-session" "${pkgdir}/usr/bin/kiro-wayfire-session"
	install -Dm644 "${_src}/usr/share/wayland-sessions/kiro-wayfire.desktop" \
		"${pkgdir}/usr/share/wayland-sessions/kiro-wayfire.desktop"
	install -Dm755 "${_src}/usr/bin/kiro-wayfire-hide-upstream-session" \
		"${pkgdir}/usr/bin/kiro-wayfire-hide-upstream-session"
	install -Dm644 "${_src}/usr/share/libalpm/hooks/kiro-wayfire-hide-upstream-session.hook" \
		"${pkgdir}/usr/share/libalpm/hooks/kiro-wayfire-hide-upstream-session.hook"

	# Pristine, read-only golden copy of the desktop config at a stable path so the
	# config can be reset back to Kiro wayfire after a user experiments.
	install -dm755 "${pkgdir}/usr/share/kiro/kiro-wayfire"
	cp -a "${_src}/etc/skel/.config/." "${pkgdir}/usr/share/kiro/kiro-wayfire/"

	if [[ -f "${_src}/LICENSE" ]]; then
		install -dm755 "${pkgdir}${_licensedir}/${pkgname}"
		install -m644 "${_src}/LICENSE" "${pkgdir}${_licensedir}/${pkgname}/"
	fi
}
